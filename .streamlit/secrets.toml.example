# Paste these into Streamlit Community Cloud: your app > Settings > Secrets.
# Locally you can copy this file to .streamlit/secrets.toml (git-ignored) or use .env instead.

BLUEPRINT_LLM_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = "sk-ant-..."

# Password viewers must enter before the app opens. Leave out to disable the gate.
BLUEPRINT_APP_PASSWORD = "choose-a-password"

# Optional: use OpenAI instead
# BLUEPRINT_LLM_PROVIDER = "openai"
# OPENAI_API_KEY = "sk-..."

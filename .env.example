# Which LLM to use: anthropic (Claude, default) or openai
BLUEPRINT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# In a Claude Code cloud environment, use BLUEPRINT_ANTHROPIC_API_KEY instead
# (that platform reserves ANTHROPIC_API_KEY for itself and hides it from sessions).
# BLUEPRINT_ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...          # only if BLUEPRINT_LLM_PROVIDER=openai or BLUEPRINT_EMBEDDINGS=openai

# Optional overrides
# BLUEPRINT_EXTRACTION_MODEL=claude-opus-5-5
# BLUEPRINT_AGENT_MODEL=claude-opus-5-5
# BLUEPRINT_CHAT_MODEL=claude-opus-5-5
# BLUEPRINT_EMBEDDINGS=local      # local (no key, default with Claude) or openai
# BLUEPRINT_EMBEDDING_MODEL=text-embedding-3-small   # used when BLUEPRINT_EMBEDDINGS=openai
# BLUEPRINT_DATA_DIR=./storage
# BLUEPRINT_VECTOR_BACKEND=chroma
# BLUEPRINT_TOLERANCE=0.10
